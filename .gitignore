# ================================
# .gitignore
# ================================

# 环境变量
.env
.env.local
.env.production

# 日志
*.log
logs/

# 依赖
node_modules/
target/
.pnpm-store/

# 构建产物
dist/
build/
.next/
out/

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 上传文件
uploads/
*.tar.gz

# SSL 证书（不提交到 Git）
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem

# 数据库备份
*.sql
backups/

# Docker 临时文件
.docker/

# 测试覆盖率
coverage/

# 临时文件
tmp/
temp/
*.tmp
