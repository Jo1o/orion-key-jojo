# ================================
# Docker 前端服务 (pnpm monorepo)
# ================================
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 使用 corepack 锁定项目指定的 pnpm 版本（packageManager: pnpm@10.29.3）
RUN corepack enable

# 复制 workspace 配置和 lock 文件（monorepo 的 lock 文件在根目录）
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/package.json

# 安装依赖（不用 --frozen-lockfile：lockfile 在 Windows 生成，缺少 linux 原生二进制记录）
RUN pnpm install --no-frozen-lockfile

# 复制源码
COPY apps/web ./apps/web

# 构建生产版本
ENV NEXT_TELEMETRY_DISABLED 1
RUN pnpm --filter @orion-key/web build

# ================================
# 运行时镜像
# ================================
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

# 创建用户
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# 复制必要文件（standalone 输出在 apps/web/.next/standalone）
COPY --from=builder /app/apps/web/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "apps/web/server.js"]
